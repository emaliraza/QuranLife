{
  "appId": "com.sukoon.app",
  "appName": "Sukoon",
  "webDir": "www",
  "backgroundColor": "#FBF5E9",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FBF5E9"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#FBF5E9"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#FBF5E9",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_sukoon",
      "iconColor": "#1F8A80"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FBF5E9"
    }
  }
}
